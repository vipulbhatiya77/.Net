@model ProductCatalog.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary mb-3">&larr; Back to Catalog</a>

    <div class="card shadow-lg">
        <div class="row g-0">
            <div class="col-md-6">
                <img src="@Model.ImageUrl" class="img-fluid rounded-start w-100" alt="@Model.Name">
            </div>
            <div class="col-md-6 p-4">
                <span class="badge bg-info text-dark mb-2">@Model.Category</span>
                <h2>@Model.Name</h2>
                <h3 class="text-success my-3">₹@Model.Price</h3>
                <p class="lead">@Model.Description</p>
            </div>
        </div>
    </div>
</div>